{
  "installCommand": "pip install --upgrade pip setuptools wheel && pip install -r requirements.txt --no-cache-dir",
  "buildCommand": "python -c 'pass'",
  "functions": {
    "**/*.py": {
      "memory": 3008,
      "maxDuration": 60
    }
  },
  "env": {
    "PYTHONUNBUFFERED": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "HF_DATASETS_OFFLINE": "1",
    "TOKENIZERS_PARALLELISM": "false",
    "PIP_NO_CACHE_DIR": "1",
    "PIP_DISABLE_PIP_VERSION_CHECK": "1",
    "UV_COMPILE_BYTECODE": "0",
    "UV_NO_CACHE": "1"
  }
}

